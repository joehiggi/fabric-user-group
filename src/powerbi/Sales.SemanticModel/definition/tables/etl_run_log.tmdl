table etl_run_log
	lineageTag: a83b43cf-bac8-5324-a0b6-0945ed5dfb04

	measure 'Load Runs' = COUNTROWS ( etl_run_log )
		formatString: #,0
		displayFolder: Ops
		lineageTag: fee01b7b-d491-578d-b006-a9ef5fc2fe92

	measure 'Failed Loads' = CALCULATE ( COUNTROWS ( etl_run_log ), etl_run_log[status] = "Failed" )
		formatString: #,0
		displayFolder: Ops
		lineageTag: 5d3157c9-757d-5565-893f-08a9331fcaf9

	measure 'Rows Loaded' = CALCULATE ( SUM ( etl_run_log[rows_read] ), etl_run_log[status] = "Succeeded" )
		formatString: #,0
		displayFolder: Ops
		lineageTag: 2522aebe-dd45-56ea-ac43-a72922c93f89

	measure 'Last Successful Load' = CALCULATE ( MAX ( etl_run_log[ended_at] ), etl_run_log[status] = "Succeeded" )
		formatString: yyyy-mm-dd hh:nn
		displayFolder: Ops
		lineageTag: ba791e40-0641-545c-9626-8c2dfb1ab1d2

	measure 'Avg Load Seconds' = AVERAGE ( etl_run_log[duration_sec] )
		formatString: 0.0
		displayFolder: Ops
		lineageTag: bafd6cc9-5368-57da-b9a9-ae297238b931

